rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && uid == request.auth.uid;
    }

    function isAdmin() {
      return signedIn()
        && (
          (
            request.auth.token.keys().hasAny(["admin"])
            && request.auth.token.admin == true
          )
          || exists(/databases/$(database)/documents/admin_whitelist/$(request.auth.uid))
        );
    }

    function onlyKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function hasKey(data, key) {
      return data.keys().hasAny([key]);
    }

    function hasAnyOwnerField(data) {
      return hasKey(data, "authorUid") || hasKey(data, "createdByUid") || hasKey(data, "userUid");
    }

    function isOwnedByCurrentUser(data) {
      return signedIn()
        && (
          (hasKey(data, "authorUid") && data.authorUid == request.auth.uid)
          || (hasKey(data, "createdByUid") && data.createdByUid == request.auth.uid)
          || (hasKey(data, "userUid") && data.userUid == request.auth.uid)
        );
    }

    function ownsNotification() {
      return signedIn() && resource.data.toUid == request.auth.uid;
    }

    function validPresenceUid(uid) {
      return isOwner(uid)
        && (!request.resource.data.keys().hasAny(["uid"]) || request.resource.data.uid == request.auth.uid);
    }

    function validPresenceValueTypes() {
      return (!request.resource.data.keys().hasAny(["online"]) || request.resource.data.online is bool)
        && (!request.resource.data.keys().hasAny(["updatedAt"]) || request.resource.data.updatedAt is timestamp);
    }

    function isSpecialConversationId(conversationId) {
      return ["dm_group_chat", "dm_foro_general"].hasAny([conversationId]);
    }

    function isConversationBetween(conversationId, uidA, uidB) {
      return uidA is string
        && uidB is string
        && (
          conversationId == uidA + "__" + uidB
          || conversationId == uidB + "__" + uidA
        );
    }

    function conversationIdNamesCurrentUser(conversationId) {
      return signedIn()
        && (
          conversationId.matches(request.auth.uid + "__.*")
          || conversationId.matches(".*__" + request.auth.uid)
        );
    }

    function isParticipant(participants) {
      return signedIn()
        && participants is list
        && request.auth.uid in participants;
    }

    function validConversationDocumentId(conversationId, participants) {
      return participants is list
        && participants.size() == 2
        && participants[0] is string
        && participants[1] is string
        && conversationId == participants[0] + "__" + participants[1];
    }

    function validConversationSummaryCreate(conversationId) {
      return signedIn()
        && onlyKeys([
          "participants",
          "lastMessageText",
          "lastMessageAt",
          "lastSenderUid",
          "updatedAt",
          "unreadCountByUid"
        ])
        && validConversationDocumentId(conversationId, request.resource.data.participants)
        && isParticipant(request.resource.data.participants)
        && (
          request.resource.data.lastSenderUid == request.auth.uid
          || (
            request.resource.data.lastSenderUid == "virtual_doctor"
            && "virtual_doctor" in request.resource.data.participants
          )
        );
    }

    function validConversationSummaryUpdate(conversationId) {
      return signedIn()
        && isParticipant(resource.data.participants)
        && validConversationDocumentId(conversationId, resource.data.participants)
        && request.resource.data.participants == resource.data.participants
        && changedOnly([
          "participants",
          "lastMessageText",
          "lastMessageAt",
          "lastSenderUid",
          "updatedAt",
          "unreadCountByUid"
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["lastSenderUid"])
          || request.resource.data.lastSenderUid == request.auth.uid
          || (
            request.resource.data.lastSenderUid == "virtual_doctor"
            && "virtual_doctor" in request.resource.data.participants
          )
        );
    }

    function validChatMessageFields() {
      return onlyKeys(["text", "from", "to", "createdAt", "readBy"])
        && request.resource.data.text is string
        && request.resource.data.from is string
        && request.resource.data.to is string;
    }

    function validUserMessageCreate(conversationId) {
      return signedIn()
        && validChatMessageFields()
        && request.resource.data.from == request.auth.uid
        && (
          (
            isSpecialConversationId(conversationId)
            && request.resource.data.to == conversationId
          )
          || (
            !isSpecialConversationId(conversationId)
            && isConversationBetween(conversationId, request.auth.uid, request.resource.data.to)
          )
        );
    }

    function validVirtualDoctorMessageCreate(conversationId) {
      return signedIn()
        && validChatMessageFields()
        && request.resource.data.from == "virtual_doctor"
        && request.resource.data.to == request.auth.uid
        && isConversationBetween(conversationId, request.auth.uid, "virtual_doctor");
    }

    function isMessageParticipant(data) {
      return signedIn()
        && (
          (hasKey(data, "from") && data.from == request.auth.uid)
          || (hasKey(data, "to") && data.to == request.auth.uid)
        );
    }

    function validChatMessageRead(conversationId, data) {
      return signedIn()
        && (
          isSpecialConversationId(conversationId)
          || (
            isMessageParticipant(data)
            && isConversationBetween(conversationId, data.from, data.to)
          )
        );
    }

    function validReadReceiptUpdate() {
      return signedIn()
        && changedOnly(["readBy", "readAt"])
        && request.resource.data.readBy is list
        && request.auth.uid in request.resource.data.readBy;
    }

    function validProfileCreate(uid) {
      return isOwner(uid)
        && onlyKeys([
          "nombre",
          "email",
          "createdAt",
          "updatedAt",
          "avatarUrl",
          "avatarUpdatedAt"
        ]);
    }

    function validProfileUpdate(uid) {
      return isOwner(uid)
        && changedOnly(["avatarUrl", "avatarUpdatedAt", "updatedAt"]);
    }

    function validCarouselType(data) {
      return !hasKey(data, "type")
        || data.type in ["image", "text", "art_gallery", "team_hobbies"];
    }

    function validImageCrop(data) {
      return !hasKey(data, "imageCrop")
        || (
          data.imageCrop is map
          && data.imageCrop.keys().hasOnly(["zoom", "offsetX", "offsetY", "frameAspect"])
          && data.imageCrop.zoom is number
          && data.imageCrop.zoom >= 1
          && data.imageCrop.zoom <= 3
          && data.imageCrop.offsetX is number
          && data.imageCrop.offsetX >= -0.5
          && data.imageCrop.offsetX <= 0.5
          && data.imageCrop.offsetY is number
          && data.imageCrop.offsetY >= -0.5
          && data.imageCrop.offsetY <= 0.5
          && data.imageCrop.frameAspect is number
          && data.imageCrop.frameAspect >= 0
          && data.imageCrop.frameAspect <= 10
        );
    }

    function validImageColorPipeline(data) {
      return !hasKey(data, "imageColorPipeline")
        || data.imageColorPipeline in ["original", "canvas-fallback"];
    }

    function validLegacyPostCreate() {
      return signedIn()
        && onlyKeys([
          "type",
          "title",
          "text",
          "imageUrl",
          "imagePath",
          "thumbUrl",
          "briefDescription",
          "longDescription",
          "artAuthor",
          "artYear",
          "artWorkType",
          "artLocation",
          "imageAspect",
          "imageWidth",
          "imageHeight",
          "imageCrop",
          "imageOriginalName",
          "imageColorPipeline",
          "authorName",
          "authorUid",
          "businessUnit",
          "managementUnit",
          "committeeId",
          "unidadNegocio",
          "unidadGestion",
          "createdByName",
          "createdByUid",
          "createdAt",
          "updatedAt",
          "likesCount",
          "likedBy",
          "likedNames",
          "likeCount",
          "commentCount"
        ])
        && hasAnyOwnerField(request.resource.data)
        && validCarouselType(request.resource.data)
        && validImageCrop(request.resource.data)
        && validImageColorPipeline(request.resource.data)
        && validOptionalString(request.resource.data, "imageOriginalName", 160)
        && (!hasKey(request.resource.data, "authorUid") || request.resource.data.authorUid == request.auth.uid)
        && (!hasKey(request.resource.data, "createdByUid") || request.resource.data.createdByUid == request.auth.uid);
    }

    function validLegacyPostContentUpdate() {
      return isOwnedByCurrentUser(resource.data)
        && changedOnly([
          "title",
          "text",
          "imageUrl",
          "imagePath",
          "thumbUrl",
          "briefDescription",
          "longDescription",
          "artAuthor",
          "artYear",
          "artWorkType",
          "artLocation",
          "imageAspect",
          "imageWidth",
          "imageHeight",
          "imageCrop",
          "imageOriginalName",
          "imageColorPipeline",
          "authorName",
          "businessUnit",
          "managementUnit",
          "committeeId",
          "unidadNegocio",
          "unidadGestion",
          "createdByName",
          "updatedAt"
        ])
        && validImageCrop(request.resource.data)
        && validImageColorPipeline(request.resource.data)
        && validOptionalString(request.resource.data, "imageOriginalName", 160)
        && (!hasKey(request.resource.data, "type") || request.resource.data.type == resource.data.type);
    }

    function validPostCreate() {
      return signedIn()
        && onlyKeys([
          "type",
          "text",
          "imageUrl",
          "imagePath",
          "authorUid",
          "authorName",
          "businessUnit",
          "managementUnit",
          "committeeId",
          "createdAt",
          "updatedAt",
          "likeCount",
          "commentCount"
        ])
        && request.resource.data.authorUid == request.auth.uid;
    }

    function validPostCounterUpdate() {
      return signedIn()
        && (
          changedOnly(["likeCount", "updatedAt"])
          || changedOnly(["commentCount", "updatedAt"])
        );
    }

    function validCommentText(data) {
      return hasKey(data, "text")
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 800;
    }

    function validOptionalString(data, key, maxLength) {
      return !hasKey(data, key)
        || data[key] == null
        || (data[key] is string && data[key].size() <= maxLength);
    }

    function validCommentCreate(commentId) {
      return signedIn()
        && onlyKeys([
          "text",
          "authorUid",
          "authorName",
          "createdAt",
          "likedBy",
          "parentCommentId",
          "rootCommentId",
          "replyDepth",
          "replyToCommentId",
          "deleted",
          "deletedAt",
          "deletedBy",
          "replyToAuthorName"
        ])
        && validCommentText(request.resource.data)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 120
        && request.resource.data.createdAt is timestamp
        && request.resource.data.likedBy is map
        && (!hasKey(request.resource.data, "deleted") || request.resource.data.deleted == false)
        && (!hasKey(request.resource.data, "deletedAt") || request.resource.data.deletedAt == null)
        && (!hasKey(request.resource.data, "deletedBy") || request.resource.data.deletedBy == "")
        && (!hasKey(request.resource.data, "replyDepth") || (
          request.resource.data.replyDepth is int
          && request.resource.data.replyDepth >= 0
          && request.resource.data.replyDepth <= 2
        ))
        && validOptionalString(request.resource.data, "parentCommentId", 160)
        && validOptionalString(request.resource.data, "rootCommentId", 160)
        && validOptionalString(request.resource.data, "replyToCommentId", 160)
        && validOptionalString(request.resource.data, "replyToAuthorName", 120)
        && (
          !hasKey(request.resource.data, "parentCommentId")
          || request.resource.data.parentCommentId == null
          || (hasKey(request.resource.data, "replyDepth") && request.resource.data.replyDepth > 0)
        )
        && (
          !hasKey(request.resource.data, "replyDepth")
          || request.resource.data.replyDepth == 0
          || (
            request.resource.data.parentCommentId is string
            && request.resource.data.parentCommentId.size() > 0
            && request.resource.data.rootCommentId is string
            && request.resource.data.rootCommentId.size() > 0
            && request.resource.data.replyToCommentId is string
            && request.resource.data.replyToCommentId.size() > 0
            && request.resource.data.replyToAuthorName is string
            && request.resource.data.replyToAuthorName.size() > 0
          )
        )
        && (
          !hasKey(request.resource.data, "replyDepth")
          || request.resource.data.replyDepth != 0
          || (
            (!hasKey(request.resource.data, "parentCommentId") || request.resource.data.parentCommentId == null)
            && (!hasKey(request.resource.data, "replyToCommentId") || request.resource.data.replyToCommentId == null)
            && (
              !hasKey(request.resource.data, "rootCommentId")
              || request.resource.data.rootCommentId == null
              || request.resource.data.rootCommentId == commentId
            )
          )
        );
    }

    function validCarouselCommentCreate(postId, commentId) {
      return validCommentCreate(commentId)
        && (
          !hasKey(request.resource.data, "replyDepth")
          || request.resource.data.replyDepth == 0
          || (
            exists(/databases/$(database)/documents/dm_carousel/$(postId)/comments/$(request.resource.data.parentCommentId))
            && (
              !hasKey(get(/databases/$(database)/documents/dm_carousel/$(postId)/comments/$(request.resource.data.parentCommentId)).data, "deleted")
              || get(/databases/$(database)/documents/dm_carousel/$(postId)/comments/$(request.resource.data.parentCommentId)).data.deleted != true
            )
            && request.resource.data.replyToCommentId == request.resource.data.parentCommentId
            && (
              (
                (
                  !hasKey(get(/databases/$(database)/documents/dm_carousel/$(postId)/comments/$(request.resource.data.parentCommentId)).data, "replyDepth")
                  || get(/databases/$(database)/documents/dm_carousel/$(postId)/comments/$(request.resource.data.parentCommentId)).data.replyDepth == 0
                )
                && request.resource.data.replyDepth == 1
                && request.resource.data.rootCommentId == request.resource.data.parentCommentId
              )
              || (
                hasKey(get(/databases/$(database)/documents/dm_carousel/$(postId)/comments/$(request.resource.data.parentCommentId)).data, "replyDepth")
                &&
                get(/databases/$(database)/documents/dm_carousel/$(postId)/comments/$(request.resource.data.parentCommentId)).data.replyDepth == 1
                && request.resource.data.replyDepth == 2
                && request.resource.data.rootCommentId == get(/databases/$(database)/documents/dm_carousel/$(postId)/comments/$(request.resource.data.parentCommentId)).data.rootCommentId
              )
            )
          )
        );
    }

    function validCommentLikeUpdate() {
      return signedIn()
        && changedOnly(["likedBy"])
        && request.resource.data.likedBy is map;
    }

    function validCommentContentUpdate() {
      return isOwnedByCurrentUser(resource.data)
        && changedOnly(["text", "updatedAt"])
        && validCommentText(request.resource.data)
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validCommentLogicalDelete() {
      return isOwnedByCurrentUser(resource.data)
        && changedOnly(["deleted", "deletedAt", "deletedBy", "updatedAt"])
        && request.resource.data.deleted == true
        && request.resource.data.deletedAt is timestamp
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validCommitteeMessageCreate() {
      return signedIn()
        && onlyKeys([
          "text",
          "author",
          "businessUnit",
          "managementUnit",
          "committeeId",
          "authorUid",
          "authorName",
          "createdAt",
          "likedBy"
        ])
        && request.resource.data.authorUid == request.auth.uid;
    }

    function validCommitteeMessageUpdate() {
      return isAdmin()
        || (
          isOwnedByCurrentUser(resource.data)
          && (
            changedOnly(["text"])
            || changedOnly(["likedBy"])
          )
        )
        || (
          signedIn()
          && changedOnly(["likedBy"])
          && request.resource.data.likedBy is map
        )
        || (
          // TODO: migrar mensajes legacy sin authorUid a una reparación backend; esta reclamación cliente conserva compatibilidad actual.
          signedIn()
          && !hasKey(resource.data, "authorUid")
          && changedOnly(["authorUid", "authorName"])
          && request.resource.data.authorUid == request.auth.uid
        );
    }

    function validCommitteeNoteText(data) {
      return data.text is string
        && data.text.size() > 0
        && data.text.size() <= 2000;
    }

    function validCommitteeNoteScope(data) {
      return data.scope in ["committee", "project"]
        && (
          (
            data.scope == "committee"
            && data.projectId == null
            && data.projectTitle is string
            && data.projectTitle.size() <= 1
          )
          || (
            data.scope == "project"
            && data.projectId is string
            && data.projectId.size() > 0
            && data.projectId.size() <= 160
            && data.projectTitle is string
            && data.projectTitle.size() > 0
            && data.projectTitle.size() <= 220
          )
        );
    }

    function validCommitteeNoteCreate() {
      return signedIn()
        && onlyKeys([
          "committeeId",
          "scope",
          "projectId",
          "projectTitle",
          "text",
          "authorUid",
          "authorName",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.committeeId is string
        && validCommitteeCalendarId(request.resource.data.committeeId)
        && validCommitteeNoteScope(request.resource.data)
        && validCommitteeNoteText(request.resource.data)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 140
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validCommitteeNoteUpdate() {
      return (isOwnedByCurrentUser(resource.data) || isAdmin())
        && request.resource.data.keys().hasOnly([
          "committeeId",
          "scope",
          "projectId",
          "projectTitle",
          "text",
          "authorUid",
          "authorName",
          "createdAt",
          "updatedAt",
          "updatedByUid",
          "updatedByName"
        ])
        && changedOnly(["text", "updatedAt", "updatedByUid", "updatedByName"])
        && request.resource.data.committeeId == resource.data.committeeId
        && request.resource.data.scope == resource.data.scope
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.projectTitle == resource.data.projectTitle
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.createdAt == resource.data.createdAt
        && validCommitteeNoteScope(request.resource.data)
        && validCommitteeNoteText(request.resource.data)
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedByName is string
        && request.resource.data.updatedByName.size() > 0
        && request.resource.data.updatedByName.size() <= 140;
    }

    function validCommitteeMemberSelfJoin() {
      return signedIn()
        && onlyKeys([
          "committeeId",
          "userUid",
          "name",
          "businessUnit",
          "managementUnit",
          "committeeRole",
          "isLeader",
          "createdAt"
        ])
        && request.resource.data.userUid == request.auth.uid
        && (
          !request.resource.data.keys().hasAny(["committeeRole"])
          || request.resource.data.committeeRole == "vocal"
        )
        && request.resource.data.isLeader == false;
    }

    function validCalendarDateKey(dateKey) {
      return dateKey is string
        && dateKey.matches("^20(26|27)-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$");
    }

    function validCalendarTitle(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 140;
    }

    function validCalendarNote(data) {
      return data.note is string
        && data.note.size() <= 4000;
    }

    function validCalendarColorKey(data) {
      return data.colorKey is string
        && (
          data.colorKey == "green"
          || data.colorKey == "blue"
          || data.colorKey == "amber"
          || data.colorKey == "red"
          || data.colorKey == "violet"
          || data.colorKey == "slate"
        );
    }

    function validCalendarDateWindow(data) {
      return validCalendarDateKey(data.dateKey)
        && validCalendarDateKey(data.startDateKey)
        && validCalendarDateKey(data.endDateKey)
        && data.dateKey == data.startDateKey
        && data.endDateKey >= data.startDateKey;
    }

    function validCalendarMinutes(data) {
      return data.allDay is bool
        && (
          data.endDateKey > data.startDateKey
          ? (
            data.allDay
            && !hasKey(data, "startMinutes")
            && !hasKey(data, "endMinutes")
          )
          : (
            (
              !hasKey(data, "startMinutes")
              && !hasKey(data, "endMinutes")
            )
            || (
              hasKey(data, "startMinutes")
              && data.startMinutes is int
              && data.startMinutes >= 0
              && data.startMinutes <= 1439
              && (
                !hasKey(data, "endMinutes")
                || (
                  data.endMinutes is int
                  && data.endMinutes >= 1
                  && data.endMinutes <= 1440
                  && data.endMinutes > data.startMinutes
                )
              )
            )
          )
        )
        && (
          !data.allDay
          || (
            !hasKey(data, "startMinutes")
            && !hasKey(data, "endMinutes")
          )
        );
    }

    function validCommitteeCalendarId(committeeId) {
      return committeeId in [
        "comite_ejecutivo_emergencias",
        "comite_salud_ocupacional",
        "comite_calidad_seguridad",
        "comite_salud_digital",
        "comite_docencia_investigacion",
        "comite_farmacia_terapeutica",
        "comite_bioetica"
      ];
    }

    function validCalendarOrigin(data) {
      return (
        !hasKey(data, "calendarScope")
        && !hasKey(data, "committeeId")
        && !hasKey(data, "committeeName")
      )
      || (
        data.calendarScope == "home"
        && !hasKey(data, "committeeId")
        && !hasKey(data, "committeeName")
      )
      || (
        data.calendarScope == "committee"
        && hasKey(data, "committeeId")
        && hasKey(data, "committeeName")
        && data.committeeId is string
        && validCommitteeCalendarId(data.committeeId)
        && data.committeeName is string
        && data.committeeName.size() > 0
        && data.committeeName.size() <= 140
      );
    }

    function validCalendarEventCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          "title",
          "note",
          "dateKey",
          "startDateKey",
          "endDateKey",
          "allDay",
          "startMinutes",
          "endMinutes",
          "colorKey",
          "calendarScope",
          "committeeId",
          "committeeName",
          "createdByUid",
          "createdByName",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "title",
          "note",
          "dateKey",
          "startDateKey",
          "endDateKey",
          "allDay",
          "colorKey",
          "createdByUid",
          "createdByName",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdByName.size() <= 140
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && validCalendarTitle(request.resource.data)
        && validCalendarNote(request.resource.data)
        && validCalendarDateWindow(request.resource.data)
        && validCalendarColorKey(request.resource.data)
        && validCalendarMinutes(request.resource.data)
        && validCalendarOrigin(request.resource.data);
    }

    function validCalendarEventUpdate() {
      return (isOwnedByCurrentUser(resource.data) || isAdmin())
        && request.resource.data.keys().hasOnly([
          "title",
          "note",
          "dateKey",
          "startDateKey",
          "endDateKey",
          "allDay",
          "startMinutes",
          "endMinutes",
          "colorKey",
          "calendarScope",
          "committeeId",
          "committeeName",
          "createdByUid",
          "createdByName",
          "createdAt",
          "updatedAt"
        ])
        && changedOnly([
          "title",
          "note",
          "dateKey",
          "startDateKey",
          "endDateKey",
          "allDay",
          "startMinutes",
          "endMinutes",
          "colorKey",
          "updatedAt"
        ])
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp
        && validCalendarTitle(request.resource.data)
        && validCalendarNote(request.resource.data)
        && validCalendarDateWindow(request.resource.data)
        && validCalendarColorKey(request.resource.data)
        && validCalendarMinutes(request.resource.data)
        && validCalendarOrigin(request.resource.data);
    }

    function validBitacoraCreateStatus(data) {
      return data.status is string
        && (
          data.status == "pending_review"
          || data.status == "draft"
        );
    }

    function validBitacoraExtractionStatus(data) {
      return data.extractionStatus is string
        && (
          data.extractionStatus == "manual"
          || data.extractionStatus == "ai_draft"
          || data.extractionStatus == "metadata_only"
          || data.extractionStatus == "failed"
          || data.extractionStatus == "not_configured"
        );
    }

    function validBitacoraExtractionSource(data) {
      return data.extractionSource is string
        && (
          data.extractionSource == "manual"
          || data.extractionSource == "url"
          || data.extractionSource == "pdf"
          || data.extractionSource == "pasted_text"
        );
    }

    function validBitacoraCreatedByShape(data) {
      return data.createdBy is map
        && data.createdBy.keys().hasOnly(["uid", "displayName", "email", "photoURL"])
        && data.createdBy.keys().hasAll(["uid", "displayName", "email"])
        && data.createdBy.uid is string
        && data.createdBy.displayName is string
        && data.createdBy.email is string
        && data.createdBy.displayName.size() > 0
        && data.createdBy.displayName.size() <= 160
        && data.createdBy.email.size() <= 240
        && (
          !data.createdBy.keys().hasAny(["photoURL"])
          || data.createdBy.photoURL is string
        );
    }

    function validBitacoraUpdatedByShape(data) {
      return !data.keys().hasAny(["updatedBy"])
        || (
          data.updatedBy is map
          && data.updatedBy.keys().hasOnly(["uid", "displayName", "email", "photoURL"])
          && data.updatedBy.keys().hasAll(["uid", "displayName", "email"])
          && data.updatedBy.uid is string
          && data.updatedBy.displayName is string
          && data.updatedBy.email is string
          && data.updatedBy.displayName.size() > 0
          && data.updatedBy.displayName.size() <= 160
          && data.updatedBy.email.size() <= 240
          && (
            !data.updatedBy.keys().hasAny(["photoURL"])
            || data.updatedBy.photoURL is string
          )
        );
    }

    function validBitacoraMethodologyProfile(data) {
      return !data.keys().hasAny(["methodologyProfile"])
        || (
          data.methodologyProfile is map
          && data.methodologyProfile.keys().size() <= 48
        );
    }

    function validBitacoraExpandedDescriptionData(data) {
      return (
          !data.keys().hasAny(["expandedDescriptionSections"])
          || (
            data.expandedDescriptionSections is list
            && data.expandedDescriptionSections.size() <= 8
          )
        )
        && (
          !data.keys().hasAny(["expandedDescriptionQuality"])
          || data.expandedDescriptionQuality in ["complete", "partial", "insufficient"]
        );
    }

    function validBitacoraFinalCompleteness(data) {
      return data.status == "draft"
        || (
          data.title.size() > 0
          && (data.sourceName.size() > 0 || data.journal.size() > 0)
          && (
            (data.keys().hasAny(["briefDescriptionEs"]) && data.briefDescriptionEs.size() > 0)
            || data.cardSummaryEs.size() > 0
            || (data.keys().hasAny(["expandedDescriptionEs"]) && data.expandedDescriptionEs.size() > 0)
            || data.executiveSummaryEs.size() > 0
            || data.executiveSummary.size() > 0
          )
          && (
            data.executiveSummaryEs.size() > 0
            || data.objectiveEs.size() > 0
            || data.clinicalQuestionEs.size() > 0
            || data.mainMessageEs.size() > 0
            || data.mainResultEs.size() > 0
            || data.studyDesignEs.size() > 0
            || data.studyContextEs.size() > 0
            || data.methodologyEs.size() > 0
            || data.studyType.size() > 0
            || data.evidenceType.size() > 0
          )
        );
    }

    function bitacoraArticleCreateKeys() {
      return [
        "title",
        "sourceName",
        "journal",
        "authors",
        "sourceDomain",
        "officialUrl",
        "doi",
        "pmid",
        "pmcid",
        "nctId",
        "pii",
        "studyType",
        "evidenceType",
        "publicationDate",
        "originalLanguage",
        "articleType",
        "studyLocation",
        "studyDesignEs",
        "studyContextEs",
        "studyPopulationEs",
        "studyLocationEs",
        "studyPeriodEs",
        "briefDescriptionEs",
        "expandedDescriptionEs",
        "expandedDescriptionSections",
        "expandedDescriptionQuality",
        "cardSummaryEs",
        "executiveSummary",
        "executiveSummaryEs",
        "abstractSummaryEs",
        "objectiveEs",
        "clinicalQuestion",
        "clinicalQuestionEs",
        "mainMessageEs",
        "mainResult",
        "mainResultEs",
        "methodologyEs",
        "keyPointsEs",
        "limitationsEs",
        "localApplicabilityEs",
        "occupationalHealthRelevanceEs",
        "methodologyProfile",
        "tags",
        "accessType",
        "userComment",
        "sourcePages",
        "extractionSource",
        "originalFileName",
        "storagePath",
        "fileSize",
        "documentContentType",
        "contentHash",
        "pageCount",
        "status",
        "extractionStatus",
        "extractionWarnings",
        "extractionConfidence",
        "createdBy",
        "createdAt",
        "updatedBy",
        "updatedAt"
      ];
    }

    function validBitacoraArticleCreateData(data) {
      return data.keys().hasOnly(bitacoraArticleCreateKeys())
        && validBitacoraCreateStatus(data)
        && validBitacoraExtractionStatus(data)
        && validBitacoraExtractionSource(data)
        && data.title is string
        && data.title.size() <= 500
        && data.sourceName is string
        && data.sourceName.size() <= 180
        && data.officialUrl is string
        && data.officialUrl.size() <= 1200
        && (!data.keys().hasAny(["authors"]) || (data.authors is list && data.authors.size() <= 30))
        && (!data.keys().hasAny(["tags"]) || (data.tags is list && data.tags.size() <= 12))
        && (!data.keys().hasAny(["keyPointsEs"]) || (data.keyPointsEs is list && data.keyPointsEs.size() <= 12))
        && (!data.keys().hasAny(["sourcePages"]) || data.sourcePages is list)
        && validBitacoraMethodologyProfile(data)
        && validBitacoraExpandedDescriptionData(data)
        && validBitacoraCreatedByShape(data)
        && validBitacoraUpdatedByShape(data)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && validBitacoraFinalCompleteness(data);
    }

    function validBitacoraArticleCreate() {
      return signedIn()
        && validBitacoraArticleCreateData(request.resource.data)
        && request.resource.data.createdBy.uid == request.auth.uid;
    }

    function bitacoraArticleEditableKeys() {
      return [
        "title",
        "sourceName",
        "journal",
        "authors",
        "sourceDomain",
        "officialUrl",
        "doi",
        "pmid",
        "pmcid",
        "nctId",
        "pii",
        "studyType",
        "evidenceType",
        "publicationDate",
        "originalLanguage",
        "articleType",
        "studyLocation",
        "studyDesignEs",
        "studyContextEs",
        "studyPopulationEs",
        "studyLocationEs",
        "studyPeriodEs",
        "briefDescriptionEs",
        "expandedDescriptionEs",
        "expandedDescriptionSections",
        "expandedDescriptionQuality",
        "cardSummaryEs",
        "executiveSummary",
        "executiveSummaryEs",
        "abstractSummaryEs",
        "objectiveEs",
        "clinicalQuestion",
        "clinicalQuestionEs",
        "mainMessageEs",
        "mainResult",
        "mainResultEs",
        "methodologyEs",
        "keyPointsEs",
        "limitationsEs",
        "localApplicabilityEs",
        "occupationalHealthRelevanceEs",
        "methodologyProfile",
        "tags",
        "accessType",
        "userComment",
        "sourcePages",
        "extractionWarnings",
        "extractionConfidence",
        "updatedBy",
        "updatedAt"
      ];
    }

    function bitacoraArticleChangedOnlyEditable() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(bitacoraArticleEditableKeys());
    }

    function validBitacoraArticleEditedFields() {
      return bitacoraArticleChangedOnlyEditable()
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 500
        && request.resource.data.sourceName is string
        && request.resource.data.sourceName.size() <= 180
        && request.resource.data.officialUrl is string
        && request.resource.data.officialUrl.size() <= 1200
        && (!request.resource.data.keys().hasAny(["authors"]) || (request.resource.data.authors is list && request.resource.data.authors.size() <= 30))
        && (!request.resource.data.keys().hasAny(["tags"]) || (request.resource.data.tags is list && request.resource.data.tags.size() <= 12))
        && (!request.resource.data.keys().hasAny(["keyPointsEs"]) || (request.resource.data.keyPointsEs is list && request.resource.data.keyPointsEs.size() <= 12))
        && (!request.resource.data.keys().hasAny(["sourcePages"]) || request.resource.data.sourcePages is list)
        && validBitacoraMethodologyProfile(request.resource.data)
        && validBitacoraExpandedDescriptionData(request.resource.data)
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is map
        && request.resource.data.updatedBy.keys().hasOnly(["uid", "displayName", "email", "photoURL"])
        && request.resource.data.updatedBy.keys().hasAll(["uid", "displayName", "email"])
        && request.resource.data.updatedBy.uid == request.auth.uid
        && request.resource.data.updatedBy.displayName is string
        && request.resource.data.updatedBy.email is string
        && request.resource.data.updatedBy.displayName.size() > 0
        && request.resource.data.updatedBy.displayName.size() <= 160
        && request.resource.data.updatedBy.email.size() <= 240
        && (
          !request.resource.data.updatedBy.keys().hasAny(["photoURL"])
          || request.resource.data.updatedBy.photoURL is string
        )
        && validBitacoraFinalCompleteness(request.resource.data);
    }

    function validBitacoraArticleManagerUpdate() {
      return signedIn()
        && (isBitacoraArticleOwner(resource.data) || isAdmin())
        && validBitacoraArticleEditedFields();
    }

    function isBitacoraArticleOwner(data) {
      return signedIn()
        && data.createdBy is map
        && data.createdBy.uid == request.auth.uid;
    }

    function validBitacoraSocialActor(data) {
      return data.keys().hasOnly(["uid", "displayName", "email", "photoURL"])
        && data.keys().hasAll(["uid", "displayName", "email"])
        && data.uid is string
        && data.displayName is string
        && data.email is string
        && data.uid == request.auth.uid
        && data.displayName.size() > 0
        && data.displayName.size() <= 160
        && data.email.size() <= 240
        && (!data.keys().hasAny(["photoURL"]) || data.photoURL is string);
    }

    function validBitacoraLikeCreate(userId) {
      return signedIn()
        && userId == request.auth.uid
        && request.resource.data.keys().hasOnly(["uid", "displayName", "email", "photoURL", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 160
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 240
        && (!request.resource.data.keys().hasAny(["photoURL"]) || request.resource.data.photoURL is string)
        && request.resource.data.createdAt is timestamp;
    }

    function bitacoraCommentKeys() {
      return ["text", "createdBy", "createdAt", "updatedAt", "status", "deletedAt", "deletedBy"];
    }

    function validBitacoraCommentText(text) {
      return text is string
        && text.size() > 0
        && text.size() <= 1000
        && text.matches("[^<>]*");
    }

    function validBitacoraCommentCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly(bitacoraCommentKeys())
        && validBitacoraCommentText(request.resource.data.text)
        && request.resource.data.createdBy is map
        && validBitacoraSocialActor(request.resource.data.createdBy)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.status == "visible"
        && request.resource.data.deletedAt == null
        && request.resource.data.deletedBy == "";
    }

    function validBitacoraCommentUpdate() {
      return signedIn()
        && (resource.data.createdBy.uid == request.auth.uid || isAdmin())
        && request.resource.data.keys().hasOnly(bitacoraCommentKeys())
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp
        && (
          (
            request.resource.data.status == "visible"
            && validBitacoraCommentText(request.resource.data.text)
            && request.resource.data.deletedAt == resource.data.deletedAt
            && request.resource.data.deletedBy == resource.data.deletedBy
          )
          || (
            request.resource.data.status == "deleted"
            && request.resource.data.text == "Comentario eliminado"
            && request.resource.data.deletedAt is timestamp
            && request.resource.data.deletedBy == request.auth.uid
          )
        );
    }

    // CAMBIO AQUI: Solo permitimos LEER la configuración (el candado cerrado)
    match /configuracion/{document=**} {
      allow read: if true;
      allow write: if false;  // <--- Nadie puede modificar la clave desde la web ahora
    }

    match /notifications/{notificationId} {
      allow read: if ownsNotification();
      allow create, delete: if false;
      allow update: if ownsNotification()
        && changedOnly(["read", "readAt"])
        && request.resource.data.read == true
        && request.resource.data.readAt is timestamp;
    }

    match /admin_whitelist/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list, create, update, delete: if false;
    }

    match /pushTokens/{uid} {
      allow read, write: if false;
    }

    match /dm_presence/{uid} {
      // TODO: migrar el roster online a una vista/endpoint owner-safe antes de hacer owner-only la lectura.
      allow read: if signedIn();
      allow create: if validPresenceUid(uid)
        && onlyKeys(["uid", "displayName", "role", "businessUnit", "managementUnit", "online", "updatedAt"])
        && validPresenceValueTypes();
      allow update: if validPresenceUid(uid)
        && changedOnly(["uid", "displayName", "role", "businessUnit", "managementUnit", "online", "updatedAt"])
        && validPresenceValueTypes();
      allow delete: if false;
    }

    match /dm_session_controls/{uid} {
      allow get: if isOwner(uid);
      allow list, create, update, delete: if false;
    }

    match /usuarios/{uid} {
      allow get: if signedIn();
      // TODO: reemplazar alias login por callable; con rules no se puede impedir enumeración por consultas limit(1) repetidas.
      allow list: if signedIn() || (request.auth == null && request.query.limit != null && request.query.limit <= 1);
      allow create: if validProfileCreate(uid);
      allow update: if validProfileUpdate(uid);
      allow delete: if false;
    }

    match /users/{document=**} {
      allow read, write: if false;
    }

    match /dm_conversations/{conversationId} {
      allow read: if isParticipant(resource.data.participants)
        && validConversationDocumentId(conversationId, resource.data.participants);
      allow create: if validConversationSummaryCreate(conversationId);
      allow update: if validConversationSummaryUpdate(conversationId);
      allow delete: if false;
    }

    match /dm_chats/{conversationId} {
      allow read, write: if false;

      match /messages/{messageId} {
        allow read: if isSpecialConversationId(conversationId)
          || conversationIdNamesCurrentUser(conversationId);
        allow create: if validUserMessageCreate(conversationId)
          || validVirtualDoctorMessageCreate(conversationId);
        allow update: if validChatMessageRead(conversationId, resource.data)
          && validReadReceiptUpdate();
        allow delete: if isOwnedByCurrentUser(resource.data) || isAdmin();
      }
    }

    // Necesario para el collectionGroup("messages") del watcher de mensajes entrantes.
    match /{path=**}/messages/{messageId} {
      allow read: if signedIn()
        && resource.data.to == request.auth.uid;
    }

    match /dm_carousel/{postId} {
      allow read: if signedIn();
      allow create: if validLegacyPostCreate();
      allow update: if validLegacyPostContentUpdate()
        || isAdmin();
      allow delete: if isOwnedByCurrentUser(resource.data) || isAdmin();

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if validCarouselCommentCreate(postId, commentId);
        allow update: if validCommentContentUpdate()
          || validCommentLogicalDelete()
          || isAdmin();
        allow delete: if isOwnedByCurrentUser(resource.data) || isAdmin();
      }

      match /likes/{uid} {
        allow read: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }
    }

    match /bitacoraArticles/{articleId} {
      allow read: if signedIn();
      allow create: if validBitacoraArticleCreate();
      allow update: if validBitacoraArticleManagerUpdate();
      allow delete: if isBitacoraArticleOwner(resource.data) || isAdmin();

      match /likes/{userId} {
        allow read: if signedIn();
        allow create: if validBitacoraLikeCreate(userId);
        allow update: if false;
        allow delete: if signedIn() && userId == request.auth.uid;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if validBitacoraCommentCreate();
        allow update: if validBitacoraCommentUpdate();
        allow delete: if signedIn() && (resource.data.createdBy.uid == request.auth.uid || isAdmin());

        match /likes/{userId} {
          allow read: if signedIn();
          allow create: if validBitacoraLikeCreate(userId);
          allow update: if false;
          allow delete: if signedIn() && userId == request.auth.uid;
        }
      }
    }

    match /dm_posts/{postId} {
      allow read: if signedIn();
      allow create: if validPostCreate();
      allow update: if isOwnedByCurrentUser(resource.data)
        || isAdmin()
        || validPostCounterUpdate();
      allow delete: if isOwnedByCurrentUser(resource.data) || isAdmin();

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if validCommentCreate(commentId);
        allow update: if validCommentLikeUpdate()
          || validCommentContentUpdate()
          || validCommentLogicalDelete()
          || isAdmin();
        allow delete: if isOwnedByCurrentUser(resource.data) || isAdmin();
      }

      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if isOwner(uid)
          && onlyKeys(["createdAt", "authorUid"])
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if false;
        allow delete: if isOwner(uid);
      }
    }

    match /dm_meta/home_visits {
      // TODO: mover el contador a backend si necesita integridad fuerte contra inflación.
      allow read: if signedIn();
      allow create: if signedIn()
        && onlyKeys(["count", "updatedAt"]);
      allow update: if signedIn()
        && changedOnly(["count", "updatedAt"]);
      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/committee_meta/{committeeId} {
      allow read: if signedIn();
      // TODO: sembrar metadata por backend/Admin SDK para cerrar también el bootstrap cliente.
      allow create: if signedIn()
        && onlyKeys(["committeeId", "title", "subtitle"])
        && request.resource.data.committeeId == committeeId;
      allow update: if isAdmin()
        && changedOnly(["committeeId", "title", "subtitle"])
        && request.resource.data.committeeId == committeeId;
      allow delete: if isAdmin();
    }

    match /artifacts/{appId}/public/data/committee_members/{memberId} {
      // TODO: las vistas actuales leen colecciones completas y filtran en cliente; migrar a queries por committeeId.
      allow read: if signedIn();
      allow create: if isAdmin() || validCommitteeMemberSelfJoin();
      allow update: if isAdmin();
      allow delete: if isAdmin() || isOwnedByCurrentUser(resource.data);
    }

    match /artifacts/{appId}/public/data/committee_topics/{topicId} {
      // TODO: las vistas actuales leen colecciones completas y filtran en cliente; migrar a queries por committeeId.
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /artifacts/{appId}/public/data/committee_messages/{messageId} {
      // TODO: las vistas actuales leen colecciones completas y filtran en cliente; migrar a queries por committeeId.
      allow read: if signedIn();
      allow create: if validCommitteeMessageCreate();
      allow update: if validCommitteeMessageUpdate();
      allow delete: if isOwnedByCurrentUser(resource.data) || isAdmin();
    }

    match /artifacts/{appId}/public/data/committee_notes/{noteId} {
      allow read: if signedIn();
      allow create: if validCommitteeNoteCreate();
      allow update: if validCommitteeNoteUpdate();
      allow delete: if isOwnedByCurrentUser(resource.data) || isAdmin();
    }

    match /artifacts/{appId}/public/data/calendar_events/{eventId} {
      allow read: if signedIn();
      allow create: if validCalendarEventCreate();
      allow update: if validCalendarEventUpdate();
      allow delete: if isOwnedByCurrentUser(resource.data) || isAdmin();
    }

    match /artifacts/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
